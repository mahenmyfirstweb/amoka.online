# Copy this file to .env.local and fill in real values. Never commit .env.local.
# SETUP.md explains where to find each value.

# Public site address, no trailing slash. Use http://localhost:3000 while developing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Secret: server only. Gives full database access.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Stripe: Developers > API keys (test keys start sk_test_, live keys sk_live_)
# Secret: server only.
STRIPE_SECRET_KEY=sk_test_replace_me
# Stripe: Developers > Webhooks > your endpoint > Signing secret
# Secret: server only.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
